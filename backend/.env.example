# Copie para .env. Preencha os valores antes de iniciar.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
JWT_SECRET=
# Opcionais localmente:
JWT_EXPIRES_IN=1d
# Storage opcional: sem estas variáveis, publicações sem fotos e perfis sem
# upload continuam funcionando. Nunca exponha essas credenciais no frontend.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# DATABASE_URL: mysql://USUARIO:SENHA_URL_ENCODED@HOST:PORTA/BANCO
# TLS: acrescente ?sslaccept=strict
# CA privada: acrescente também &sslcert=/caminho/absoluto/ca.pem
