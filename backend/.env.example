# Copie para .env. Preencha os valores antes de iniciar.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
JWT_SECRET=
# Opcionais localmente:
JWT_EXPIRES_IN=1d
# DATABASE_URL: mysql://USUARIO:SENHA_URL_ENCODED@HOST:PORTA/BANCO
# TLS: acrescente ?sslaccept=strict
# CA privada: acrescente também &sslcert=/caminho/absoluto/ca.pem
