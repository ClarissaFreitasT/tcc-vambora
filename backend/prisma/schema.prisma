generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id               String              @id @default(uuid()) @db.Char(36)
  nome             String              @db.VarChar(255)
  email            String              @unique @db.VarChar(255)
  dataNascimento   DateTime?           @map("data_nascimento") @db.Date
  username         String?             @unique @db.VarChar(80)
  senhaHash        String              @map("senha_hash") @db.VarChar(255)
  role             UserRole            @default(USER)
  fotoUrl          String?             @map("foto_url") @db.VarChar(255)
  bio              String?             @db.Text
  personalidade    Personalidade?
  criadoEm         DateTime            @default(now()) @map("criado_em")
  favoritos        Favorito[]
  reviews          Review[]
  roteiros         Roteiro[]
  publicacoes      Publicacao[]
  comentarios      Comentario[]
  curtidasPublica  CurtidaPublicacao[]
  seguidores       Seguidor[]          @relation("SeguidorSeguido")
  seguindo         Seguidor[]          @relation("SeguidorSeguidor")
  roteirosSalvos   SalvoRoteiro[]
  publicacoesSalvas SalvoPublicacao[]
  denunciasPublicacoes DenunciaPublicacao[]
  planejamentosIa PlanejamentoIa[]
  operacoesIa OperacaoIa[]

  @@map("usuarios")
}

model Roteiro {
  id                 String             @id @default(uuid()) @db.Char(36)
  usuarioId          String             @map("usuario_id") @db.Char(36)
  roteiroOriginalId  String?            @map("roteiro_original_id") @db.Char(36)
  titulo             String             @db.VarChar(255)
  descricao          String?            @db.Text
  destino            String             @db.VarChar(255)
  imagemUrl          String?            @map("imagem_url") @db.VarChar(500)
  orcamento          Decimal?           @db.Decimal(10, 2)
  publico            Boolean            @default(false)
  dataIda            DateTime?          @map("data_ida") @db.Date
  dataVolta          DateTime?          @map("data_volta") @db.Date
  pessoas            Int?
  cidades            Json?
  revisao            Int                @default(0)
  planejamentoIa     PlanejamentoIa?
  criadoEm           DateTime           @default(now()) @map("criado_em")
  dias               DiaDoRoteiro[]
  favoritos          Favorito[]
  reviews            Review[]
  categorias         RoteiroCategoria[]
  salvos             SalvoRoteiro[]
  publicacoes        Publicacao[]
  roteiroOriginal    Roteiro?           @relation("DuplicacaoRoteiro", fields: [roteiroOriginalId], references: [id])
  roteirosDuplicados Roteiro[]          @relation("DuplicacaoRoteiro")
  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([roteiroOriginalId])
  @@map("roteiros")
}

model DiaDoRoteiro {
  id        String          @id @default(uuid()) @db.Char(36)
  roteiroId String          @map("roteiro_id") @db.Char(36)
  numeroDia Int             @map("numero_dia")
  cidadePrincipal String?    @map("cidade_principal") @db.VarChar(255)
  titulo    String?         @db.VarChar(255)
  roteiro   Roteiro         @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  itens     ItemDoRoteiro[]

  @@unique([roteiroId, numeroDia])
  @@index([roteiroId])
  @@map("dias_do_roteiro")
}

model ItemDoRoteiro {
  id            String       @id @default(uuid()) @db.Char(36)
  diaId         String       @map("dia_id") @db.Char(36)
  titulo        String       @db.VarChar(255)
  descricao     String?      @db.Text
  localNome     String?      @map("local_nome") @db.VarChar(255)
  custoEstimado Decimal?     @map("custo_estimado") @db.Decimal(10, 2)
  horarioInicio DateTime?    @map("horario_inicio") @db.Time(0)
  ordem         Int          @default(0)
  dia           DiaDoRoteiro @relation(fields: [diaId], references: [id], onDelete: Cascade)

  @@index([diaId])
  @@map("itens_do_roteiro")
}

model PlanejamentoIa {
  id String @id @default(uuid()) @db.Char(36)
  usuarioId String @map("usuario_id") @db.Char(36)
  roteiroId String? @unique @map("roteiro_id") @db.Char(36)
  dadosIniciais Json @map("dados_iniciais")
  gerandoAte DateTime? @map("gerando_ate")
  operacaoAtual String? @map("operacao_atual") @db.Char(36)
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  roteiro Roteiro? @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  mensagens MensagemIa[]
  propostas PropostaIa[]
  operacoes OperacaoIa[]
  @@index([usuarioId, atualizadoEm])
  @@map("planejamentos_ia")
}

model MensagemIa {
  id String @id @default(uuid()) @db.Char(36)
  planejamentoId String @map("planejamento_id") @db.Char(36)
  papel String @db.VarChar(20)
  texto String @db.Text
  criadoEm DateTime @default(now()) @map("criado_em")
  planejamento PlanejamentoIa @relation(fields: [planejamentoId], references: [id], onDelete: Cascade)
  @@index([planejamentoId, criadoEm])
  @@map("mensagens_ia")
}

model PropostaIa {
  id String @id @default(uuid()) @db.Char(36)
  planejamentoId String @map("planejamento_id") @db.Char(36)
  conteudo Json
  resumo String @db.Text
  revisaoBase Int? @map("revisao_base")
  estado String @default("pendente") @db.VarChar(20)
  criadoEm DateTime @default(now()) @map("criado_em")
  planejamento PlanejamentoIa @relation(fields: [planejamentoId], references: [id], onDelete: Cascade)
  @@index([planejamentoId, estado])
  @@map("propostas_ia")
}

model OperacaoIa {
  id String @id @default(uuid()) @db.Char(36)
  usuarioId String @map("usuario_id") @db.Char(36)
  planejamentoId String? @map("planejamento_id") @db.Char(36)
  chave String @db.VarChar(80)
  hash String @db.Char(64)
  estado String @default("processando") @db.VarChar(20)
  erro String? @db.VarChar(255)
  criadoEm DateTime @default(now()) @map("criado_em")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planejamento PlanejamentoIa? @relation(fields: [planejamentoId], references: [id], onDelete: SetNull)
  @@unique([usuarioId, chave])
  @@index([usuarioId, criadoEm])
  @@map("operacoes_ia")
}

model Favorito {
  id        String  @id @default(uuid()) @db.Char(36)
  usuarioId String  @map("usuario_id") @db.Char(36)
  roteiroId String  @map("roteiro_id") @db.Char(36)
  roteiro   Roteiro @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, roteiroId])
  @@index([usuarioId])
  @@index([roteiroId])
  @@map("favoritos")
}

model Categoria {
  id       String             @id @default(uuid()) @db.Char(36)
  nome     String             @unique @db.VarChar(255)
  roteiros RoteiroCategoria[]
  publicacoes PublicacaoCategoria[]

  @@map("categorias")
}

model RoteiroCategoria {
  roteiroId   String    @map("roteiro_id") @db.Char(36)
  categoriaId String    @map("categoria_id") @db.Char(36)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  roteiro     Roteiro   @relation(fields: [roteiroId], references: [id], onDelete: Cascade)

  @@id([roteiroId, categoriaId])
  @@index([categoriaId])
  @@map("roteiro_categorias")
}

model Review {
  id         String   @id @default(uuid()) @db.Char(36)
  usuarioId  String   @map("usuario_id") @db.Char(36)
  roteiroId  String   @map("roteiro_id") @db.Char(36)
  nota       Int
  comentario String?  @db.Text
  criadoEm   DateTime @default(now()) @map("criado_em")
  roteiro    Roteiro  @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, roteiroId])
  @@index([usuarioId])
  @@index([roteiroId])
  @@map("reviews")
}

model Seguidor {
  id          String @id @default(uuid()) @db.Char(36)
  seguidorId  String @map("seguidor_id") @db.Char(36)
  seguidoId   String @map("seguido_id") @db.Char(36)
  seguidor    Usuario @relation("SeguidorSeguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido     Usuario @relation("SeguidorSeguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@index([seguidorId])
  @@index([seguidoId])
  @@map("seguidores")
}

model Publicacao {
  id         String   @id @default(uuid()) @db.Char(36)
  usuarioId  String   @map("usuario_id") @db.Char(36)
  roteiroId  String?  @map("roteiro_id") @db.Char(36)
  texto      String   @db.Text
  criadoEm   DateTime @default(now()) @map("criado_em")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  roteiro    Roteiro? @relation(fields: [roteiroId], references: [id], onDelete: SetNull)
  comentarios Comentario[]
  curtidas CurtidaPublicacao[]
  fotos PublicacaoFoto[]
  categorias PublicacaoCategoria[]
  salvos SalvoPublicacao[]
  denuncias DenunciaPublicacao[]

  @@index([usuarioId])
  @@index([roteiroId])
  @@index([criadoEm, id])
  @@map("publicacoes")
}

model PublicacaoFoto {
  id           String     @id @default(uuid()) @db.Char(36)
  publicacaoId String     @map("publicacao_id") @db.Char(36)
  url          String     @db.VarChar(500)
  ordem        Int        @default(0)
  publicacao   Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@index([publicacaoId, ordem])
  @@map("publicacoes_fotos")
}

model PublicacaoCategoria {
  publicacaoId String     @map("publicacao_id") @db.Char(36)
  categoriaId  String     @map("categoria_id") @db.Char(36)
  publicacao   Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([publicacaoId, categoriaId])
  @@index([categoriaId, publicacaoId])
  @@map("publicacoes_categorias")
}

model SalvoPublicacao {
  id           String     @id @default(uuid()) @db.Char(36)
  usuarioId    String     @map("usuario_id") @db.Char(36)
  publicacaoId String     @map("publicacao_id") @db.Char(36)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  publicacao   Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, publicacaoId])
  @@index([usuarioId, criadoEm])
  @@map("publicacoes_salvas")
}

model DenunciaPublicacao {
  id           String      @id @default(uuid()) @db.Char(36)
  usuarioId    String      @map("usuario_id") @db.Char(36)
  publicacaoId String?     @map("publicacao_id") @db.Char(36)
  motivo       String      @db.VarChar(80)
  detalhe      String?     @db.Text
  estado       String      @default("ABERTA") @db.VarChar(20)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  publicacao   Publicacao? @relation(fields: [publicacaoId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, publicacaoId])
  @@index([estado, criadoEm])
  @@index([publicacaoId])
  @@map("denuncias_publicacoes")
}

model Comentario {
  id         String   @id @default(uuid()) @db.Char(36)
  texto      String   @db.Text
  usuarioId  String   @map("usuario_id") @db.Char(36)
  publicacaoId String @map("publicacao_id") @db.Char(36)
  comentarioPaiId String? @map("comentario_pai_id") @db.Char(36)
  criadoEm   DateTime @default(now()) @map("criado_em")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  publicacao Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  comentarioPai Comentario? @relation("RespostasComentario", fields: [comentarioPaiId], references: [id], onDelete: Cascade)
  respostas  Comentario[] @relation("RespostasComentario")

  @@index([publicacaoId])
  @@index([usuarioId])
  @@map("comentarios")
}

model CurtidaPublicacao {
  id         String   @id @default(uuid()) @db.Char(36)
  usuarioId  String   @map("usuario_id") @db.Char(36)
  publicacaoId String @map("publicacao_id") @db.Char(36)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  publicacao Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, publicacaoId])
  @@map("curtidas_publicacao")
}

model SalvoRoteiro {
  id        String  @id @default(uuid()) @db.Char(36)
  usuarioId  String  @map("usuario_id") @db.Char(36)
  roteiroId  String  @map("roteiro_id") @db.Char(36)
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  roteiro    Roteiro @relation(fields: [roteiroId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, roteiroId])
  @@index([usuarioId])
  @@index([roteiroId])
  @@map("roteiros_salvos")
}

enum Personalidade {
  AVENTUREIRA
  CULTURAL
  FESTEIRA
  TRANQUILA
}

enum UserRole {
  USER
  ADMIN
}
