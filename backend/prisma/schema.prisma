generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id              String         @id @default(uuid()) @db.Char(36)
  nome            String         @db.VarChar(255)
  email           String         @unique @db.VarChar(255)
  senhaHash       String         @map("senha_hash") @db.VarChar(255)
  fotoUrl         String?        @map("foto_url") @db.VarChar(255)
  bio             String?        @db.Text
  personalidade   Personalidade?
  criadoEm        DateTime       @default(now()) @map("criado_em")
  favoritos       Favorito[]
  reviews         Review[]
  roteiros        Roteiro[]

  @@map("usuarios")
}

model Roteiro {
  id                 String             @id @default(uuid()) @db.Char(36)
  usuarioId          String             @map("usuario_id") @db.Char(36)
  roteiroOriginalId  String?            @map("roteiro_original_id") @db.Char(36)
  titulo             String             @db.VarChar(255)
  descricao          String?            @db.Text
  destino            String             @db.VarChar(255)
  orcamento          Decimal?           @db.Decimal(10, 2)
  publico            Boolean            @default(false)
  criadoEm           DateTime           @default(now()) @map("criado_em")
  dias               DiaDoRoteiro[]
  favoritos          Favorito[]
  reviews            Review[]
  categorias         RoteiroCategoria[]
  roteiroOriginal    Roteiro?           @relation("DuplicacaoRoteiro", fields: [roteiroOriginalId], references: [id])
  roteirosDuplicados Roteiro[]          @relation("DuplicacaoRoteiro")
  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([roteiroOriginalId])
  @@map("roteiros")
}

model DiaDoRoteiro {
  id        String          @id @default(uuid()) @db.Char(36)
  roteiroId String          @map("roteiro_id") @db.Char(36)
  numeroDia Int             @map("numero_dia")
  titulo    String?         @db.VarChar(255)
  roteiro   Roteiro         @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  itens     ItemDoRoteiro[]

  @@unique([roteiroId, numeroDia])
  @@index([roteiroId])
  @@map("dias_do_roteiro")
}

model ItemDoRoteiro {
  id            String       @id @default(uuid()) @db.Char(36)
  diaId         String       @map("dia_id") @db.Char(36)
  titulo        String       @db.VarChar(255)
  descricao     String?      @db.Text
  localNome     String?      @map("local_nome") @db.VarChar(255)
  custoEstimado Decimal?     @map("custo_estimado") @db.Decimal(10, 2)
  horarioInicio DateTime?    @map("horario_inicio") @db.Time(0)
  ordem         Int          @default(0)
  dia           DiaDoRoteiro @relation(fields: [diaId], references: [id], onDelete: Cascade)

  @@index([diaId])
  @@map("itens_do_roteiro")
}

model Favorito {
  id        String  @id @default(uuid()) @db.Char(36)
  usuarioId String  @map("usuario_id") @db.Char(36)
  roteiroId String  @map("roteiro_id") @db.Char(36)
  roteiro   Roteiro @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, roteiroId])
  @@index([usuarioId])
  @@index([roteiroId])
  @@map("favoritos")
}

model Categoria {
  id       String             @id @default(uuid()) @db.Char(36)
  nome     String             @unique @db.VarChar(255)
  roteiros RoteiroCategoria[]

  @@map("categorias")
}

model RoteiroCategoria {
  roteiroId   String    @map("roteiro_id") @db.Char(36)
  categoriaId String    @map("categoria_id") @db.Char(36)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  roteiro     Roteiro   @relation(fields: [roteiroId], references: [id], onDelete: Cascade)

  @@id([roteiroId, categoriaId])
  @@index([categoriaId])
  @@map("roteiro_categorias")
}

model Review {
  id         String   @id @default(uuid()) @db.Char(36)
  usuarioId  String   @map("usuario_id") @db.Char(36)
  roteiroId  String   @map("roteiro_id") @db.Char(36)
  nota       Int
  comentario String?  @db.Text
  criadoEm   DateTime @default(now()) @map("criado_em")
  roteiro    Roteiro  @relation(fields: [roteiroId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, roteiroId])
  @@index([usuarioId])
  @@index([roteiroId])
  @@map("reviews")
}

enum Personalidade {
  AVENTUREIRA
  CULTURAL
  FESTEIRA
  TRANQUILA
}
